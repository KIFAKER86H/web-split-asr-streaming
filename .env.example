# คัดลอกไฟล์นี้เป็น .env แล้ววางไว้ที่รากโปรเจค
#
# Next.js อ่านให้อัตโนมัติทั้งตอน `npm run dev` และ `npm start`
# ตัวแปรของระบบจะทับค่าในไฟล์นี้เสมอ
#
# ค่าทั้งหมดถูกอ่านฝั่งเซิร์ฟเวอร์ ไม่มีตัวไหนขึ้นต้นด้วย NEXT_PUBLIC_
# จึงไม่มีค่าใดถูกฝังลงไปในไฟล์ JS ที่ส่งให้เบราว์เซอร์

# คีย์จาก https://www.assemblyai.com/dashboard/api-keys
# ค่านี้อยู่ฝั่งเซิร์ฟเวอร์เท่านั้น — SharedWorker hub ขอโทเค็นชั่วคราวผ่าน GET /api/token
#
# เว้นว่างได้ถ้า ASSEMBLYAI_WS_ENDPOINT ชี้ไปที่เซิร์ฟเวอร์ของตัวเองที่ไม่ต้อง auth
# (แต่ถ้าชี้ไป *.assemblyai.com ต้องมีคีย์เสมอ)
ASSEMBLYAI_API_KEY=

# ปลายทางของ API — เว้นว่างไว้เพื่อใช้ค่าเริ่มต้นด้านล่าง
# เปลี่ยนได้เมื่อต้องการล็อก data residency (เช่น streaming.eu.assemblyai.com)
# ชี้ไป proxy หรือชี้ไปเซิร์ฟเวอร์ v3 ที่ deploy เอง
#
# ⚠️ ตัว SharedWorker hub เป็นผู้ต่อ WebSocket เอง (ไม่ใช่หน้าเว็บโดยตรง แต่ก็ยังทำงาน
#    ในเบราว์เซอร์ ไม่ได้ผ่านเซิร์ฟเวอร์ Node) ถ้าเปิดหน้าเว็บผ่าน https:// ต้องใช้ wss://
#    เท่านั้น — ws:// จะถูกบล็อกด้วยกฎ mixed content และเครื่องของผู้ใช้ต้องมองเห็น host นี้ได้โดยตรง
ASSEMBLYAI_TOKEN_ENDPOINT=https://streaming.assemblyai.com/v3/token
ASSEMBLYAI_WS_ENDPOINT=wss://streaming.assemblyai.com/v3/ws

# อายุของโทเค็น (วินาที) — ช่วงที่ใช้ไถ่ถอนได้ 1-600
ASSEMBLYAI_TOKEN_EXPIRES_IN=60
# ความยาวสูงสุดของหนึ่งเซสชัน (วินาที) — 60-10800
ASSEMBLYAI_MAX_SESSION_SECONDS=3600

# ขนาดก้อนเสียง (ms) ที่ worklet รวมไว้ก่อนส่งขึ้น WebSocket แต่ละครั้ง — 50-1000
# (ช่วงที่ AssemblyAI รับได้) ค่ายิ่งเล็ก = ดีเลย์ต่ำกว่าแต่ยิงถี่กว่า, ค่ายิ่งใหญ่ = ยิงห่างกว่า
# แต่ latency สูงขึ้น ค่าเริ่มต้น 100ms คือค่าที่แอปนี้ใช้มาตั้งแต่แรก ปรับได้ที่นี่จุดเดียว
# ไม่มีในแผงตั้งค่า F2 เพราะเป็นการจูนระดับโปรโตคอล ไม่ใช่สิ่งที่ควรเปลี่ยนกลางการใช้งานจริง
ASSEMBLYAI_CHUNK_MS=100

# โมเดลแปลภาษาสำหรับแท็บที่ตั้งเป็น "แปล" — endpoint แบบ OpenAI-compatible (vLLM, Ollama, ฯลฯ)
# เว้น TEXT_BASE_URL หรือ TEXT_MODEL_NAME ว่าง = ปิดการแปล แท็บแปลจะโชว์ข้อความแจ้งเตือนแทน
#
# การเรียกโมเดลเกิดที่ /api/translate ฝั่งเซิร์ฟเวอร์ (เรียกโดย SharedWorker hub ครั้งเดียว
# ต่อประโยค ไม่ว่าจะเปิดกี่แท็บ) TEXT_API_KEY จึงไม่ถูกส่งให้เบราว์เซอร์ และ TEXT_BASE_URL
# จะเป็น host ในเครือข่ายภายในที่ผู้ใช้มองไม่เห็นก็ได้
TEXT_MODEL_NAME=
TEXT_BASE_URL=
TEXT_API_KEY=

# งบประมาณ (โดยประมาณ เป็นโทเค็น) ของ "บทสนทนาก่อนหน้า" ที่ส่งแนบไปกับทุกประโยคที่แปล
# เพื่อให้โมเดลแปลต่อเนื่องกัน (คำสรรพนาม ชื่อเฉพาะ หัวข้อที่กำลังพูด) แทนที่จะแปลทีละ
# ประโยคแบบตัดขาดจากกัน — SharedWorker hub เป็นผู้เก็บประวัติ (ข้อความต้นฉบับ + คำแปล)
# ของเซสชันนั้นไว้ แล้วส่งแนบมาให้ route นี้ตัดให้พอดีงบตรงนี้ก่อนส่งเข้าโมเดลจริง
#
# 0 = ปิดการส่ง context ไปเลย แปลทีละประโยคแยกกันเหมือนเดิม
# ตัวเลขเป็นการประมาณคร่าว ๆ (~3 ตัวอักษรต่อโทเค็น) ไม่ใช่การนับโทเค็นจริงจากตัวโมเดล
CONTEXT_TOKENS=128

# ─── ชุด API ที่สอง ("slot 2") — สำหรับสลับด้วยคีย์ลัด (ค่าเริ่มต้น F3) ───────────
# ทุกตัวด้านล่างเป็นคู่แฝดของตัวแปรด้านบน แค่เติม _B ต่อท้าย — ใช้ endpoint,
# ภูมิภาค, หรือบัญชีอีกชุดที่ตั้งค่าแยกกันได้อิสระ
#
# ⚠️ ตัวชี้วัดว่า "มีชุดที่สองจริงไหม" คือ ASSEMBLYAI_WS_ENDPOINT_B เพียงตัวเดียว —
#    ถ้าเว้นว่างไว้ ทั้งฟีเจอร์นี้จะปิดไปเลย คีย์ลัดจะไม่ทำอะไรแม้จะกด (ตามที่ตั้งใจ)
#    ต่อให้ตั้งค่าตัวอื่น ๆ ด้านล่างไว้ครบก็ตาม
# ถ้าจะใช้ endpoint เดียวกับชุดแรกแต่คนละคีย์/คอนฟิก ก็ยังต้องใส่ ASSEMBLYAI_WS_ENDPOINT_B
# ซ้ำกับตัวบนอยู่ดี เพื่อเป็นการ "ยืนยัน" ว่าตั้งใจเปิดชุดที่สองจริง ๆ
#
# เว้นว่างตัวไหนที่เหลือไว้ = ใช้ค่าเริ่มต้นเดียวกับชุดแรก (เช่น TOKEN_ENDPOINT ที่เป็น
# assemblyai.com เหมือนกันทั้งคู่ ต่างแค่คีย์)
ASSEMBLYAI_API_KEY_B=
ASSEMBLYAI_TOKEN_ENDPOINT_B=
ASSEMBLYAI_WS_ENDPOINT_B=
ASSEMBLYAI_TOKEN_EXPIRES_IN_B=60
ASSEMBLYAI_MAX_SESSION_SECONDS_B=3600

# การแปลของชุดที่สอง — เป็นอิสระจากชุดแรกโดยสิ้นเชิง (ปิดอันหนึ่งเปิดอีกอันได้ตามใจ)
TEXT_MODEL_NAME_B=
TEXT_BASE_URL_B=
TEXT_API_KEY_B=
CONTEXT_TOKENS_B=128

# ─── ค่า CAPTION_* ทั้งหมดเป็นแค่ "ค่าเริ่มต้น" ────────────────────────────────
# ฟอนต์ ขนาดตัวอักษร ระยะห่างบรรทัด และการแสดง partial ปรับได้จากแผง F2 ของแต่ละแท็บ
# ค่าที่ปรับจะถูกเก็บใน localStorage ของเบราว์เซอร์นั้น (ใช้ร่วมกันทุกแท็บ) และทับค่าด้านล่างนี้
# ส่วน "แท็บนี้แสดงอะไร" (ถอดเสียง/แปล) เป็นค่าเฉพาะแท็บ เก็บใน sessionStorage แยกกันคนละแท็บ
# กดปุ่ม "คืนค่าจาก .env" ในแผงเพื่อกลับมาใช้ค่าที่นี่
#
# ฟอนต์ของข้อความ caption — ใส่เป็นค่า CSS ตรง ๆ เว้นว่างเพื่อใช้ค่าเริ่มต้น
# ค่าที่มี ; { } < > จะถูกปฏิเสธและกลับไปใช้ค่าเริ่มต้น ชื่อหลายคำไม่ต้องใส่เครื่องหมายคำพูด
#
# ฟอนต์ที่ bundle มากับโปรเจค (ใช้ได้ทุกเครื่อง ไม่ต้องติดตั้ง) — เลือกจากแผง F2 ได้เลย:
#   var(--font-caption)           Prompt — ไทย+ละติน (ค่าเริ่มต้น)
#   var(--font-sarabun)           Sarabun — ทางการ ราชการ
#   var(--font-plex-thai)         IBM Plex Sans Thai — องค์กร
#   var(--font-noto-thai)         Noto Sans Thai — กลาง ๆ
#   var(--font-kanit)             Kanit — หนา เห็นชัด
#   var(--font-mitr)              Mitr — กลม อ่านไกล
#   var(--font-bai-jamjuree)      Bai Jamjuree — เหลี่ยม เทคนิค
#   var(--font-noto-serif-thai)   Noto Serif Thai — มีเชิง
#   var(--font-trirong)           Trirong — มีเชิง คมกว่า
#   var(--font-geist-sans)        Geist — ละตินเท่านั้น ไม่มีตัวไทย
#   var(--font-geist-mono)        Geist Mono — ละตินเท่านั้น
# จะเพิ่มฟอนต์ Google ตัวอื่นต้องแก้ src/app/fonts.ts แล้ว build ใหม่
CAPTION_FONT_FAMILY=var(--font-caption), sans-serif
# รับได้ทั้ง 28px, 1.75rem หรือ clamp(...) สำหรับปรับตามความกว้างจอ
CAPTION_FONT_SIZE=clamp(1.1rem, min(2.5vw, 4vh), 4.4rem)
# ตัวเลขล้วนคือสัดส่วนของขนาดฟอนต์ หรือใส่หน่วยเช่น 2.75rem ก็ได้
CAPTION_LINE_HEIGHT=1.9
# ต้องเป็นน้ำหนักที่โหลดไว้ใน layout.tsx เท่านั้น ไม่งั้นเบราว์เซอร์จะปลอมให้
CAPTION_FONT_WEIGHT=300
# ระยะห่างตัวอักษร — ค่าบวกเล็กน้อยทำให้ตัวบางดูโปร่งขึ้น
CAPTION_LETTER_SPACING=0.01em

# แสดงข้อความระหว่างที่ยังพูดไม่จบประโยคหรือไม่ (true/false) — มีผลกับแท็บถอดเสียงเท่านั้น
CAPTION_SHOW_PARTIAL=false

# การเลื่อนข้อความ: auto | smooth | reduced
CAPTION_SCROLL_MOTION=auto

# ยกข้อความขึ้นจากขอบล่างของจอกี่ % ของความสูงจอ (0-30) — ปรับได้จากแผงตั้งค่า (F2) เช่นกัน
# ใช้เผื่อจอนี้มีอย่างอื่นซ้อนอยู่ด้านล่าง (โลโก้แถบล่าง, OBS source อื่น, ทาสก์บาร์)
# 0 = ชิดขอบเหมือนเดิม
CAPTION_BOTTOM_GAP=0
